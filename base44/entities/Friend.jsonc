{
  "name": "Friend",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "friend_user_id": {
      "type": "string"
    },
    "friend_name": {
      "type": "string"
    },
    "friend_picture": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "blocked"
      ],
      "default": "pending"
    },
    "requester_name": {
      "type": "string"
    },
    "requester_picture": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.friend_user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.friend_user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.friend_user_id": "{{user.id}}"
        }
      ]
    }
  }
}
