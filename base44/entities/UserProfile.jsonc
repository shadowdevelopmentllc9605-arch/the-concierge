{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to the user"
    },
    "birthday": {
      "type": "string",
      "format": "date"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "prefer_not_to_say"
      ]
    },
    "profile_picture": {
      "type": "string",
      "description": "URL to profile picture"
    },
    "body_scan_front": {
      "type": "string",
      "description": "URL to front body scan image"
    },
    "body_scan_side": {
      "type": "string",
      "description": "URL to side body scan image"
    },
    "body_scan_back": {
      "type": "string",
      "description": "URL to back body scan image"
    },
    "measurement_unit": {
      "type": "string",
      "enum": [
        "metric",
        "imperial"
      ],
      "default": "imperial"
    },
    "measurement_confidence": {
      "type": "number",
      "description": "Image quality/confidence score from 0-100; not a guarantee of accuracy"
    },
    "measurement_method": {
      "type": "string"
    },
    "measurement_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "measurement_values_cm": {
      "type": "object",
      "description": "Canonical numeric body measurements stored in centimeters",
      "properties": {
        "height": {
          "type": "number"
        },
        "chest": {
          "type": "number"
        },
        "bust": {
          "type": "number"
        },
        "waist": {
          "type": "number"
        },
        "hips": {
          "type": "number"
        },
        "shoulders": {
          "type": "number"
        },
        "arm_length": {
          "type": "number"
        },
        "inseam": {
          "type": "number"
        },
        "neck": {
          "type": "number"
        },
        "underbust": {
          "type": "number"
        },
        "foot_length": {
          "type": "number"
        },
        "head_circumference": {
          "type": "number"
        },
        "foot_width": {
          "type": "number"
        },
        "calf_circumference": {
          "type": "number"
        }
      }
    },
    "measurements": {
      "type": "object",
      "properties": {
        "chest": {
          "type": "string"
        },
        "bust": {
          "type": "string"
        },
        "waist": {
          "type": "string"
        },
        "hips": {
          "type": "string"
        },
        "inseam": {
          "type": "string"
        },
        "shoulders": {
          "type": "string"
        },
        "arm_length": {
          "type": "string"
        },
        "height": {
          "type": "string"
        },
        "weight": {
          "type": "string"
        },
        "neck": {
          "type": "string"
        },
        "shoe_size": {
          "type": "string"
        },
        "underbust": {
          "type": "string"
        },
        "foot_length": {
          "type": "string"
        },
        "bra_size": {
          "type": "string"
        },
        "head_circumference": {
          "type": "string"
        },
        "foot_width": {
          "type": "string"
        },
        "calf_circumference": {
          "type": "string"
        },
        "shoe_width": {
          "type": "string"
        }
      }
    },
    "suggested_sizes": {
      "type": "object",
      "properties": {
        "tops": {
          "type": "string"
        },
        "bottoms": {
          "type": "string"
        },
        "dresses": {
          "type": "string"
        },
        "suits": {
          "type": "string"
        },
        "underwear": {
          "type": "string"
        },
        "footwear": {
          "type": "string"
        },
        "headwear": {
          "type": "string"
        },
        "outerwear": {
          "type": "string"
        },
        "footwear_width": {
          "type": "string"
        }
      }
    },
    "style_preferences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "business, casual, nightlife, trendy"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "onboarding_step": {
      "type": "number",
      "default": 1
    },
    "wishlist_visibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "default": "private"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Server-managed Stripe customer ID",
      "rls": {
        "write": false
      }
    },
    "measurement_validation_status": {
      "type": "string",
      "enum": [
        "estimated",
        "reviewed",
        "partially_verified",
        "verified"
      ],
      "default": "estimated",
      "description": "Trust state for the body measurement profile. Verified means key fit measurements were independently confirmed by the customer."
    },
    "measurement_sources": {
      "type": "object",
      "description": "Per-measurement provenance used by fit-confidence logic.",
      "properties": {
        "height": {
          "type": "string"
        },
        "chest": {
          "type": "string"
        },
        "bust": {
          "type": "string"
        },
        "underbust": {
          "type": "string"
        },
        "waist": {
          "type": "string"
        },
        "hips": {
          "type": "string"
        },
        "inseam": {
          "type": "string"
        },
        "shoulders": {
          "type": "string"
        },
        "arm_length": {
          "type": "string"
        },
        "neck": {
          "type": "string"
        },
        "head_circumference": {
          "type": "string"
        },
        "foot_length": {
          "type": "string"
        },
        "foot_width": {
          "type": "string"
        },
        "calf_circumference": {
          "type": "string"
        }
      }
    },
    "measurement_confidence_by_field": {
      "type": "object",
      "description": "Per-measurement confidence score from 0-100; image-derived confidence is not a guarantee of accuracy.",
      "properties": {
        "height": {
          "type": "number"
        },
        "chest": {
          "type": "number"
        },
        "bust": {
          "type": "number"
        },
        "underbust": {
          "type": "number"
        },
        "waist": {
          "type": "number"
        },
        "hips": {
          "type": "number"
        },
        "inseam": {
          "type": "number"
        },
        "shoulders": {
          "type": "number"
        },
        "arm_length": {
          "type": "number"
        },
        "neck": {
          "type": "number"
        },
        "head_circumference": {
          "type": "number"
        },
        "foot_length": {
          "type": "number"
        },
        "foot_width": {
          "type": "number"
        },
        "calf_circumference": {
          "type": "number"
        }
      }
    },
    "measurement_scan_diagnostics": {
      "type": "object",
      "description": "Non-sensitive scan quality diagnostics used to explain retake requirements.",
      "properties": {
        "pose_visibility": {
          "type": "number"
        },
        "silhouette_coverage": {
          "type": "number"
        },
        "front_back_width_agreement": {
          "type": "number"
        },
        "orientation_score": {
          "type": "number"
        }
      }
    }
  },
  "required": [],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}