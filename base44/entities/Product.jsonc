{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "suits",
        "vests",
        "dress_shirts",
        "pants",
        "blouse",
        "dress_skirts",
        "polos",
        "tshirts",
        "jackets",
        "jeans",
        "shorts",
        "khakis",
        "dresses",
        "skirts",
        "jumpers",
        "pattern_shirts",
        "graphic_tees",
        "sports_jackets",
        "evening_dresses",
        "hats",
        "glasses",
        "earrings",
        "necklaces",
        "bracelets",
        "watches",
        "belts",
        "socks",
        "shoes",
        "collar_stays",
        "cufflinks",
        "tie_bar",
        "tie_chain",
        "tie_pin",
        "pocket_square",
        "lapel_pin"
      ]
    },
    "style_type": {
      "type": "string",
      "enum": [
        "business",
        "casual",
        "nightlife",
        "trendy"
      ]
    },
    "price": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tryOn_image": {
      "type": "string",
      "description": "Transparent image for virtual try-on"
    },
    "sizes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "colors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "size_chart": {
      "type": "array",
      "description": "Optional brand/product-specific size chart in centimeters",
      "items": {
        "type": "object",
        "properties": {
          "size": {
            "type": "string"
          },
          "chest_min_cm": {
            "type": "number"
          },
          "chest_max_cm": {
            "type": "number"
          },
          "waist_min_cm": {
            "type": "number"
          },
          "waist_max_cm": {
            "type": "number"
          },
          "hips_min_cm": {
            "type": "number"
          },
          "hips_max_cm": {
            "type": "number"
          },
          "inseam_min_cm": {
            "type": "number"
          },
          "inseam_max_cm": {
            "type": "number"
          }
        }
      }
    },
    "vendor_id": {
      "type": "string"
    },
    "in_stock": {
      "type": "boolean",
      "default": true
    },
    "is_new": {
      "type": "boolean",
      "default": false
    },
    "linked_pro_inventory_id": {
      "type": "string"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "size": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "stock_quantity": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "stock_quantity": {
      "type": "number",
      "default": 0
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
