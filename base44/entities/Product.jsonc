{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "suits",
        "vests",
        "dress_shirts",
        "pants",
        "blouse",
        "dress_skirts",
        "polos",
        "tshirts",
        "jackets",
        "jeans",
        "shorts",
        "khakis",
        "dresses",
        "skirts",
        "jumpers",
        "pattern_shirts",
        "graphic_tees",
        "sports_jackets",
        "evening_dresses",
        "hats",
        "glasses",
        "earrings",
        "necklaces",
        "bracelets",
        "watches",
        "belts",
        "socks",
        "shoes",
        "collar_stays",
        "cufflinks",
        "tie_bar",
        "tie_chain",
        "tie_pin",
        "pocket_square",
        "lapel_pin",
        "underwear",
        "bras",
        "lingerie",
        "sleepwear",
        "boots",
        "coats",
        "parkas",
        "outerwear",
        "swimwear"
      ]
    },
    "style_type": {
      "type": "string",
      "enum": [
        "business",
        "casual",
        "nightlife",
        "trendy",
        "formal",
        "evening",
        "outdoor",
        "active"
      ]
    },
    "price": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tryOn_image": {
      "type": "string",
      "description": "Transparent image for virtual try-on"
    },
    "sizes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "colors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "size_chart": {
      "type": "array",
      "description": "Optional brand/product-specific size chart in centimeters",
      "items": {
        "type": "object",
        "properties": {
          "size": {
            "type": "string"
          },
          "chest_min_cm": {
            "type": "number"
          },
          "chest_max_cm": {
            "type": "number"
          },
          "waist_min_cm": {
            "type": "number"
          },
          "waist_max_cm": {
            "type": "number"
          },
          "hips_min_cm": {
            "type": "number"
          },
          "hips_max_cm": {
            "type": "number"
          },
          "inseam_min_cm": {
            "type": "number"
          },
          "inseam_max_cm": {
            "type": "number"
          },
          "numeric_equivalent": {
            "type": "string"
          },
          "neck_min_cm": {
            "type": "number"
          },
          "neck_max_cm": {
            "type": "number"
          },
          "sleeve_min_cm": {
            "type": "number"
          },
          "sleeve_max_cm": {
            "type": "number"
          },
          "foot_length_min_cm": {
            "type": "number"
          },
          "foot_length_max_cm": {
            "type": "number"
          },
          "height_min_cm": {
            "type": "number"
          },
          "height_max_cm": {
            "type": "number"
          },
          "bust_min_cm": {
            "type": "number"
          },
          "bust_max_cm": {
            "type": "number"
          },
          "underbust_min_cm": {
            "type": "number"
          },
          "underbust_max_cm": {
            "type": "number"
          },
          "us_size": {
            "type": "string"
          },
          "uk_size": {
            "type": "string"
          },
          "eu_size": {
            "type": "string"
          },
          "jp_size": {
            "type": "string"
          },
          "alternate_size": {
            "type": "string"
          },
          "band_size": {
            "type": "string"
          },
          "cup_size": {
            "type": "string"
          },
          "head_circumference_min_cm": {
            "type": "number"
          },
          "head_circumference_max_cm": {
            "type": "number"
          },
          "foot_width_min_cm": {
            "type": "number"
          },
          "foot_width_max_cm": {
            "type": "number"
          },
          "calf_circumference_min_cm": {
            "type": "number"
          },
          "calf_circumference_max_cm": {
            "type": "number"
          },
          "width_code": {
            "type": "string"
          },
          "width_label": {
            "type": "string"
          }
        }
      }
    },
    "vendor_id": {
      "type": "string"
    },
    "in_stock": {
      "type": "boolean",
      "default": true
    },
    "is_new": {
      "type": "boolean",
      "default": false
    },
    "linked_pro_inventory_id": {
      "type": "string"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "size": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "stock_quantity": {
            "type": "number",
            "default": 0
          },
          "width_code": {
            "type": "string"
          }
        }
      }
    },
    "stock_quantity": {
      "type": "number",
      "default": 0
    },
    "discontinued": {
      "type": "boolean",
      "default": false
    },
    "processed_stock_events": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "footwear_type": {
      "type": "string",
      "enum": [
        "all",
        "athletic_running",
        "athletic_training",
        "walking",
        "casual_sneaker",
        "dress_oxford_derby",
        "loafer_slipon",
        "boot_work",
        "boot_hiking",
        "boot_fashion",
        "sandal",
        "heel_pump",
        "other"
      ],
      "default": "all"
    },
    "width_options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "footwear_fit": {
      "type": "object",
      "properties": {
        "last_name": {
          "type": "string"
        },
        "fit_profile": {
          "type": "string",
          "enum": [
            "true_to_size",
            "snug",
            "roomy",
            "runs_small",
            "runs_large",
            "unknown"
          ],
          "default": "unknown"
        },
        "size_adjustment_steps": {
          "type": "number"
        },
        "sock_profile": {
          "type": "string",
          "enum": [
            "thin",
            "standard",
            "thick",
            "varies",
            "not_applicable"
          ],
          "default": "not_applicable"
        },
        "fit_notes": {
          "type": "string"
        }
      }
    },
    "size_chart_measurement_basis": {
      "type": "string",
      "enum": [
        "body",
        "garment",
        "mixed",
        "unknown"
      ],
      "default": "body",
      "description": "Whether size-chart values describe the wearer body, finished garment, or a mixture."
    },
    "garment_fit": {
      "type": "object",
      "description": "Construction and intended-fit metadata used to interpret garment measurements.",
      "properties": {
        "fit_cut": {
          "type": "string",
          "enum": [
            "compression",
            "skinny",
            "slim",
            "tailored",
            "regular",
            "relaxed",
            "oversized",
            "unknown"
          ],
          "default": "unknown"
        },
        "stretch_level": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "unknown"
          ],
          "default": "unknown"
        },
        "fabric_behavior": {
          "type": "string",
          "enum": [
            "rigid",
            "structured",
            "draped",
            "stretchy",
            "mixed",
            "unknown"
          ],
          "default": "unknown"
        },
        "layering_allowance": {
          "type": "string",
          "enum": [
            "none",
            "light",
            "standard",
            "heavy",
            "unknown"
          ],
          "default": "unknown"
        },
        "intended_fit_notes": {
          "type": "string"
        },
        "data_source": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "source_retrieved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "garment_measurements": {
      "type": "array",
      "description": "Optional finished-garment measurements by labeled size, stored in centimeters.",
      "items": {
        "type": "object",
        "properties": {
          "size": {
            "type": "string"
          },
          "chest_cm": {
            "type": "number"
          },
          "bust_cm": {
            "type": "number"
          },
          "waist_cm": {
            "type": "number"
          },
          "hips_cm": {
            "type": "number"
          },
          "shoulders_cm": {
            "type": "number"
          },
          "sleeve_cm": {
            "type": "number"
          },
          "inseam_cm": {
            "type": "number"
          },
          "rise_cm": {
            "type": "number"
          },
          "thigh_cm": {
            "type": "number"
          },
          "garment_length_cm": {
            "type": "number"
          },
          "foot_internal_length_cm": {
            "type": "number"
          },
          "foot_internal_width_cm": {
            "type": "number"
          },
          "calf_opening_cm": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}