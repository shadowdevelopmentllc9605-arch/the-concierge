{
  "name": "IntegrationConfig",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "key",
    "token"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
