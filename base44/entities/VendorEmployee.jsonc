          "type": "boolean",
          "default": false
        },
        "edit_floor_plan": {
          "type": "boolean",
          "default": false
        },
        "open_close": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [],
