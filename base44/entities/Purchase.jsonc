{
  "name": "Purchase",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "product_image": {
      "type": "string"
    },
    "product_price": {
      "type": "number"
    },
    "size": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "vendor_id": {
      "type": "string"
    },
    "vendor_name": {
      "type": "string"
    },
    "purchase_type": {
      "type": "string",
      "enum": [
        "online",
        "in_store"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "processing",
        "shipped",
        "delivered",
        "completed",
        "refunded"
      ],
      "default": "processing"
    },
    "external_purchase_id": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "location_id": {
      "type": "string"
    },
    "external_line_key": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "create": false,
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": false,
    "delete": false
  }
}
