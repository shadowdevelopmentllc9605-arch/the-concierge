{
  "name": "Vendor",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "business_picture": {
      "type": "string"
    },
    "floor_plan_image": {
      "type": "string"
    },
    "style_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "id": {
            "type": "string"
          }
        }
      }
    },
    "setup_completed": {
      "type": "boolean",
      "default": false
    },
    "linked_pro_business_id": {
      "type": "string"
    },
    "stripe_connected_account_id": {
      "type": "string",
      "rls": {
        "write": false
      }
    },
    "stripe_onboarding_complete": {
      "type": "boolean",
      "default": false,
      "rls": {
        "write": false
      }
    },
    "stripe_charges_enabled": {
      "type": "boolean",
      "default": false,
      "rls": {
        "write": false
      }
    },
    "stripe_payouts_enabled": {
      "type": "boolean",
      "default": false,
      "rls": {
        "write": false
      }
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}