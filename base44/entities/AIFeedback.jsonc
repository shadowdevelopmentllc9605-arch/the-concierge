{
  "name": "AIFeedback",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "feedback_type": {
      "type": "string",
      "enum": [
        "recommendation",
        "try_on",
        "size_suggestion",
        "style_match"
      ],
      "description": "Type of AI feature being rated"
    },
    "product_id": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "accuracy_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "How accurate was the AI prediction"
    },
    "feedback_text": {
      "type": "string"
    },
    "was_helpful": {
      "type": "boolean"
    },
    "actual_outcome": {
      "type": "string",
      "description": "What actually happened vs prediction"
    },
    "suggested_size": {
      "type": "string",
      "description": "Size AI suggested"
    },
    "actual_size_needed": {
      "type": "string",
      "description": "Size user actually needed"
    },
    "fit_result": {
      "type": "string",
      "enum": [
        "too_tight",
        "ideal",
        "too_loose",
        "mixed",
        "not_tried"
      ],
      "description": "Observed real-world fit."
    },
    "problem_areas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Where the item fit poorly, e.g. waist, chest, shoulders, sleeves, toe box."
    },
    "kept_item": {
      "type": "boolean"
    },
    "return_reason": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "recommendation_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "width_code": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}