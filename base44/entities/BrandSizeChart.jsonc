{
  "name": "BrandSizeChart",
  "type": "object",
  "properties": {
    "brand_name": {
      "type": "string"
    },
    "brand_key": {
      "type": "string"
    },
    "parent_name": {
      "type": "string"
    },
    "manufacturer_name": {
      "type": "string"
    },
    "relationship_type": {
      "type": "string"
    },
    "region": {
      "type": "string",
      "default": "US"
    },
    "audience": {
      "type": "string",
      "enum": [
        "men",
        "women",
        "unisex",
        "kids",
        "unknown"
      ]
    },
    "category_group": {
      "type": "string",
      "enum": [
        "tops",
        "bottoms",
        "dresses",
        "suits",
        "outerwear",
        "underwear",
        "footwear",
        "unisex_clothing",
        "other",
        "headwear"
      ]
    },
    "chart_name": {
      "type": "string"
    },
    "fit_type": {
      "type": "string"
    },
    "measurement_basis": {
      "type": "string",
      "enum": [
        "body",
        "garment",
        "mixed"
      ],
      "default": "body"
    },
    "source_url": {
      "type": "string"
    },
    "source_retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "official_brand",
        "official_corporate",
        "verified_partner",
        "manual"
      ]
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "version": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "size": {
            "type": "string"
          },
          "numeric_equivalent": {
            "type": "string"
          },
          "chest_min_cm": {
            "type": "number"
          },
          "chest_max_cm": {
            "type": "number"
          },
          "waist_min_cm": {
            "type": "number"
          },
          "waist_max_cm": {
            "type": "number"
          },
          "hips_min_cm": {
            "type": "number"
          },
          "hips_max_cm": {
            "type": "number"
          },
          "inseam_min_cm": {
            "type": "number"
          },
          "inseam_max_cm": {
            "type": "number"
          },
          "neck_min_cm": {
            "type": "number"
          },
          "neck_max_cm": {
            "type": "number"
          },
          "sleeve_min_cm": {
            "type": "number"
          },
          "sleeve_max_cm": {
            "type": "number"
          },
          "foot_length_min_cm": {
            "type": "number"
          },
          "foot_length_max_cm": {
            "type": "number"
          },
          "height_min_cm": {
            "type": "number"
          },
          "height_max_cm": {
            "type": "number"
          },
          "bust_min_cm": {
            "type": "number"
          },
          "bust_max_cm": {
            "type": "number"
          },
          "underbust_min_cm": {
            "type": "number"
          },
          "underbust_max_cm": {
            "type": "number"
          },
          "us_size": {
            "type": "string"
          },
          "uk_size": {
            "type": "string"
          },
          "eu_size": {
            "type": "string"
          },
          "jp_size": {
            "type": "string"
          },
          "alternate_size": {
            "type": "string"
          },
          "band_size": {
            "type": "string"
          },
          "cup_size": {
            "type": "string"
          },
          "head_circumference_min_cm": {
            "type": "number"
          },
          "head_circumference_max_cm": {
            "type": "number"
          },
          "foot_width_min_cm": {
            "type": "number"
          },
          "foot_width_max_cm": {
            "type": "number"
          },
          "calf_circumference_min_cm": {
            "type": "number"
          },
          "calf_circumference_max_cm": {
            "type": "number"
          },
          "width_code": {
            "type": "string"
          },
          "width_label": {
            "type": "string"
          }
        }
      }
    },
    "gender_detail": {
      "type": "string",
      "enum": [
        "boys",
        "girls",
        "unisex",
        "not_applicable",
        "unknown"
      ],
      "default": "not_applicable"
    },
    "footwear_type": {
      "type": "string",
      "enum": [
        "all",
        "athletic_running",
        "athletic_training",
        "walking",
        "casual_sneaker",
        "dress_oxford_derby",
        "loafer_slipon",
        "boot_work",
        "boot_hiking",
        "boot_fashion",
        "sandal",
        "heel_pump",
        "other"
      ],
      "default": "all"
    },
    "last_name": {
      "type": "string"
    },
    "width_system": {
      "type": "string"
    },
    "fit_guidance": {
      "type": "string"
    },
    "sock_profile": {
      "type": "string",
      "enum": [
        "thin",
        "standard",
        "thick",
        "varies",
        "not_applicable"
      ],
      "default": "not_applicable"
    },
    "size_adjustment_steps": {
      "type": "number",
      "description": "Optional official/product-specific half-size step adjustment. 1 = +0.5 US size, -1 = -0.5. Zero/absent means no automatic adjustment."
    }
  },
  "required": [
    "brand_name",
    "brand_key",
    "region",
    "audience",
    "category_group",
    "chart_name",
    "source_url",
    "entries"
  ],
  "rls": {
    "create": false,
    "read": true,
    "update": false,
    "delete": false
  }
}