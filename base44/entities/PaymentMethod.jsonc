{
  "name": "PaymentMethod",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "card_last_four": {
      "type": "string"
    },
    "card_type": {
      "type": "string"
    },
    "expiry_month": {
      "type": "number"
    },
    "expiry_year": {
      "type": "number"
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "billing_address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "zip": {
          "type": "string"
        }
      }
    },
    "processor": {
      "type": "string",
      "enum": [
        "stripe"
      ]
    },
    "processor_payment_method_id": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "create": false,
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": false,
    "delete": false
  }
}